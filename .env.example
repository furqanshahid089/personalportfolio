# =========================================================================
# Environment variables for the Furqan Shahid portfolio (Django).
# Copy this file to ".env" and fill in real values. Never commit ".env".
# =========================================================================

# --- Core -----------------------------------------------------------------
# Generate a new secret key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed hosts (no scheme).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include scheme), e.g.:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Leave empty to use the local SQLite database (development default).
# For PostgreSQL in production, set a URL, e.g.:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Require SSL for the database connection (usually True on managed Postgres).
DB_SSL_REQUIRE=False

# --- Production security ---------------------------------------------------
# Redirect all HTTP traffic to HTTPS when DEBUG=False.
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security max-age in seconds (1 year default).
SECURE_HSTS_SECONDS=31536000
